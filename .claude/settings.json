{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",

      "Bash(npm run dev)",
      "Bash(npm run dev:*)",
      "Bash(npm run build)",
      "Bash(npm run build:*)",
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run start)",
      "Bash(npm run start:*)",
      "Bash(npx create-next-app*)",
      "Bash(npx tsc:*)",
      "Bash(npx --no tsc:*)",
      "Bash(tsc:*)",
      "Bash(node --version)",
      "Bash(node -v)",

      "Bash(git init)",
      "Bash(git init:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(git remote)",
      "Bash(git remote:*)",

      "Bash(mv:*)",
      "Bash(rmdir:*)",
      "Bash(grep:*)",

      "Bash(vercel link)",
      "Bash(vercel link:*)",
      "Bash(vercel env pull:*)",
      "Bash(vercel env ls:*)",
      "Bash(vercel whoami)",

      "PowerShell(npm run dev:*)",
      "PowerShell(npm run build:*)",
      "PowerShell(npm run lint:*)",
      "PowerShell(npm run start:*)",
      "PowerShell(npx create-next-app*)",
      "PowerShell(npx tsc:*)",
      "PowerShell(npx --no tsc:*)",
      "PowerShell(git init)",
      "PowerShell(git init:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "PowerShell(git ls-files:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git remote:*)",
      "PowerShell(vercel link:*)",
      "PowerShell(vercel env pull:*)",
      "PowerShell(vercel env ls:*)"
    ],

    "deny": [
      "Bash(npm *prisma*)",
      "Bash(npm *drizzle*)",
      "Bash(npm *kysely*)",
      "Bash(npm *typeorm*)",
      "Bash(npm *sequelize*)",
      "Bash(npm *knex*)",
      "Bash(npm *mikro-orm*)",
      "Bash(npx prisma*)",
      "Bash(npx drizzle-kit*)",
      "Bash(npm exec prisma*)",
      "Bash(npm exec drizzle-kit*)",
      "PowerShell(npm *prisma*)",
      "PowerShell(npm *drizzle*)",
      "PowerShell(npm *kysely*)",
      "PowerShell(npm *typeorm*)",
      "PowerShell(npm *sequelize*)",
      "PowerShell(npm *knex*)",
      "PowerShell(npm *mikro-orm*)",
      "PowerShell(npx prisma*)",
      "PowerShell(npx drizzle-kit*)",
      "PowerShell(npm exec prisma*)",
      "PowerShell(npm exec drizzle-kit*)",

      "Bash(vercel)",
      "Bash(vercel deploy*)",
      "Bash(vercel --prod*)",
      "Bash(vercel redeploy*)",
      "Bash(vercel promote*)",
      "Bash(npx vercel*)",
      "Bash(pnpm dlx vercel*)",
      "Bash(bunx vercel*)",
      "PowerShell(vercel)",
      "PowerShell(vercel deploy*)",
      "PowerShell(vercel --prod*)",
      "PowerShell(vercel redeploy*)",
      "PowerShell(vercel promote*)",
      "PowerShell(npx vercel*)",
      "PowerShell(pnpm dlx vercel*)",
      "PowerShell(bunx vercel*)",

      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *-f)",
      "Bash(git push *--no-verify*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push *-f *)",
      "PowerShell(git push *-f)",
      "PowerShell(git push *--no-verify*)",

      "Bash(git commit *--amend*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(git -c * push*)",
      "Bash(git -c * commit*)",
      "Bash(git -c * rebase*)",
      "PowerShell(git commit *--amend*)",
      "PowerShell(git commit *--no-verify*)",
      "PowerShell(git rebase*)",
      "PowerShell(git reset*)",
      "PowerShell(git -c * push*)",
      "PowerShell(git -c * commit*)",
      "PowerShell(git -c * rebase*)",

      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm *-rf*)",
      "PowerShell(Remove-Item *-Recurse*)",
      "PowerShell(rm *-Recurse*)",

      "Read(.env)",
      "Read(.env*)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(cat *.env*)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-orm.sh\"",
            "shell": "/bin/bash",
            "timeout": 10,
            "statusMessage": "Checking for ORM installs"
          }
        ]
      }
    ]
  }
}
